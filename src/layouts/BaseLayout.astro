---
/**
 * @component BaseLayout
 * @description The foundational HTML structure for all pages.
 * Handles SEO, Google Fonts integration, and global design tokens.
 */
import "../assets/styles/global.css";

interface Props {
  title: string; // Page title for SEO and browser tab
  description?: string; // Meta description for search engines
  image?: string; // Social share image (OG Image)
}

const {
  title,
  description = "Communications Lead & Web Developer | Multimedia Strategy for Global Conservation",
  image = "/placeholder-social.jpg",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/fav.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- DESIGN_SYSTEM_FONTS_START -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- DESIGN_SYSTEM_FONTS_END -->
  </head>
  <body
    class="min-h-screen bg-background font-sans antialiased text-foreground"
  >
    <div class="relative flex min-h-screen flex-col">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    /* DESIGN_SYSTEM_VARIABLES_START */
    --font-sans: "Inter", system-ui, -apple-system, sans-serif;
    --font-heading: "Montserrat", var(--font-sans);
    /* DESIGN_SYSTEM_VARIABLES_END */
  }

  html {
    font-family: var(--font-sans);
    scroll-behavior: smooth;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-heading);
  }
</style>
