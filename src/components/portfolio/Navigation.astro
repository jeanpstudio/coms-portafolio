---
import { Home } from 'lucide-react';

const { pathname } = Astro.url;
const isHome = pathname === '/' || pathname === '';
const isProjectPage = pathname.startsWith('/projects/');

// 🟢 EDITAR: Define los enlaces de navegación. 
// Si estás en el home, usa anclas (#). Si estás en una subpágina, usa rutas absolutas (/#).
const navItems = [
  { name: 'Work', href: isHome ? '#casos' : '/#casos' },
  { name: 'Field Experience', href: isHome ? '#field-experience' : '/#field-experience' },
  { name: 'Skills', href: isHome ? '#skills' : '/#skills' },
  { name: 'Contact', href: isHome ? '#contacto' : '/#contacto' },
];
---

<!-- 🟢 NAVBAR: Navegación principal inteligente. En móviles se optimiza el espacio -->
<header 
  id="main-nav"
  data-scrolled="false"
  class="fixed top-0 left-0 right-0 z-[100] transition-all duration-500 ease-in-out w-full group py-6 data-[scrolled=true]:bg-white/95 data-[scrolled=true]:backdrop-blur-xl data-[scrolled=true]:shadow-md data-[scrolled=true]:py-4 data-[scrolled=false]:bg-gradient-to-b data-[scrolled=false]:from-black/60 data-[scrolled=false]:to-transparent"
>
  <div class="container mx-auto px-4 md:px-6 flex items-center justify-between transition-all duration-500">
    <!-- Home Action (Only on Projects) -->
    <div class="w-12">
      {isProjectPage && (
        <a 
          href="/" 
          class="inline-flex items-center justify-center p-2 rounded-full transition-all duration-500 group-data-[scrolled=true]:text-black group-data-[scrolled=true]:bg-zinc-100 group-data-[scrolled=false]:text-white group-data-[scrolled=false]:bg-white/10 hover:scale-110 active:scale-95"
          aria-label="Back to Home"
        >
          <Home className="w-5 h-5" />
        </a>
      )}
    </div>

    <!-- Nav Items -->
    <nav class="hidden md:flex items-center gap-10">
      {navItems.map((item) => (
        <a 
          href={item.href} 
          class="text-sm font-bold tracking-widest uppercase transition-all duration-500 group-data-[scrolled=true]:text-zinc-600 group-data-[scrolled=true]:hover:text-primary group-data-[scrolled=false]:text-white/80 group-data-[scrolled=false]:hover:text-white hover:scale-110"
        >
          {item.name}
        </a>
      ))}
    </nav>
    
    <!-- Mobile Nav Button (Contact) -->
    <div class="md:hidden">
        <a 
          href="#contacto" 
          class="text-xs font-black tracking-widest uppercase px-5 py-2.5 rounded-full border transition-all duration-500 group-data-[scrolled=true]:border-primary group-data-[scrolled=true]:text-primary group-data-[scrolled=false]:border-white/40 group-data-[scrolled=false]:text-white group-data-[scrolled=false]:bg-white/5 active:scale-95"
        >
          Contact
        </a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');

  function handleScroll() {
    if (window.scrollY > 20) {
      nav?.setAttribute('data-scrolled', 'true');
    } else {
      nav?.setAttribute('data-scrolled', 'false');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  // Run on load
  handleScroll();
</script>
