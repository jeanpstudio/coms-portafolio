---
interface Props {
  context: string;
  challenge: string;
  solution?: string;
  storyImage?: string;
  highlightQuote?: string;
}

const { 
  context, 
  challenge, 
  solution, 
  storyImage = "https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&q=80&w=1000",
  highlightQuote = "The greatest challenge wasn't just the logistics, but planting a narrative that would endure."
} = Astro.props;

// Función simple para parsear negritas de markdown y saltos de línea
const formatSolution = (text: string) => {
  if (!text) return "";
  return text
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') // Negritas
    .replace(/\n/g, '<br/>'); // Saltos de línea
};
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 md:px-6">
    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
      <div class="space-y-12">
        <!-- Bloque de Contexto -->
        <div class="relative pl-16 group">
          <div class="absolute left-0 top-0 w-12 h-12 bg-zinc-100 rounded-2xl flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500 shadow-sm">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
            </svg>
          </div>
          <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground mb-3">01. The Context</h3>
          <p class="text-xl text-foreground font-medium leading-relaxed tracking-tight">
            {context}
          </p>
        </div>

        <!-- Bloque de Desafío -->
        <div class="relative pl-16 group">
          <div class="absolute left-0 top-0 w-12 h-12 bg-red-50 rounded-2xl flex items-center justify-center text-red-600 group-hover:bg-red-600 group-hover:text-white transition-all duration-500 shadow-sm border border-red-100">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-red-600 mb-3">02. The Challenge</h3>
          <p class="text-xl text-foreground font-medium leading-relaxed tracking-tight">
            {challenge}
          </p>
        </div>

        <!-- Bloque de Solución -->
        <div class="relative pl-16 group">
          <div class="absolute left-0 top-0 w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-white transition-all duration-500 shadow-sm border border-emerald-100">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-primary mb-3">03. The Solution</h3>
          <div class="text-xl text-foreground font-medium leading-relaxed tracking-tight prose-simple">
            {solution ? (
              <Fragment set:html={formatSolution(solution)} />
            ) : (
              <slot />
            )}
          </div>
        </div>
      </div>

      <div class="relative group mt-12 md:mt-0">
        <div class="aspect-[4/5] rounded-[2.5rem] overflow-hidden bg-muted shadow-2xl">
          <img 
            src={storyImage} 
            alt="Contexto ambiental" 
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000 scale-110 group-hover:scale-100"
          />
        </div>
        <div class="absolute -bottom-10 -left-10 bg-foreground text-background p-10 rounded-[2rem] shadow-2xl max-w-xs hidden lg:block border border-white/10 backdrop-blur-md">
          <!-- 🟢 EDITAR: Frase destacada sobre el contexto/desafío -->
          <p class="text-lg font-bold leading-tight uppercase tracking-tighter">
            "{highlightQuote}"
          </p>
          <div class="mt-4 h-1 w-12 bg-primary"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .prose-simple p {
    margin-bottom: 1rem;
  }
  .prose-simple p:last-child {
    margin-bottom: 0;
  }
  .prose-simple strong {
    font-weight: 800;
    color: var(--primary);
  }
  .prose-simple h3 {
    font-weight: 800;
    font-size: 1.25rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: -0.025em;
  }
</style>
