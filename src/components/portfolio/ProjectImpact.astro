---
interface Metric {
  label: string;
  value: string;
  description?: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<!-- 🟢 SECCIÓN DE IMPACTO: Renderiza métricas clave del proyecto -->
<section class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-4 md:px-6 relative z-10">
    <div class="max-w-5xl mx-auto">
        <div class="text-center mb-20 text-balance">
            <h2 class="text-4xl md:text-6xl font-extrabold tracking-tight text-foreground mb-6">The Impact</h2>
            <p class="text-xl text-muted-foreground font-medium max-w-2xl mx-auto">Transforming operational presence into tangible, data-driven results for reforestation and global visibility.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {metrics.map((metric) => (
                <div class="group relative p-10 rounded-[2.5rem] bg-zinc-50 border border-zinc-100 hover:bg-emerald-50/50 hover:border-emerald-100 transition-all duration-700 flex flex-col h-full">
                    {/* Header: Value & Label */}
                    <div class="mb-8">
                        <div class="text-5xl md:text-6xl font-black text-primary mb-3 group-hover:scale-110 transition-transform duration-700 origin-left">
                            {metric.value}
                        </div>
                        <div class="text-[10px] font-black uppercase tracking-[0.2em] text-muted-foreground opacity-60 group-hover:text-primary group-hover:opacity-100 transition-all">
                            {metric.label}
                        </div>
                    </div>
                    
                    {/* Description: The story behind the number */}
                    {metric.description && (
                        <p class="text-sm font-medium text-muted-foreground leading-relaxed mt-auto pt-6 border-t border-zinc-200/60 group-hover:border-emerald-200 transition-colors">
                            {metric.description}
                        </p>
                    )}
                </div>
            ))}
        </div>
    </div>
  </div>
</section>
