---
/**
 * @component Header
 * @description Sticky navigation header with backdrop blur effect.
 * Uses standard Astro components for routing.
 */
const navItems = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog" },
  { label: "About", href: "/about" },
];
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container flex h-14 items-center justify-between mx-auto px-4">
    <div class="mr-4 flex">
      <a href="/" class="mr-6 flex items-center space-x-2">
        <span class="inline-block font-bold text-xl ring-offset-background transition-colors hover:text-primary">
          AstroStarter
        </span>
      </a>
      <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
        {navItems.map(item => (
          <a
            href={item.href}
            class="transition-colors hover:text-foreground/80 text-foreground/60"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="flex flex-1 items-center justify-end space-x-2">
      <div class="w-full flex-1 md:w-auto md:flex-none">
        <!-- Add Search or Theme Toggle here -->
      </div>
      <nav class="flex items-center space-x-2">
        <a
          href="https://github.com/astro-starter"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 hover:bg-accent hover:text-accent-foreground h-9 py-2 px-3"
        >
          GitHub
        </a>
      </nav>
    </div>
  </div>
</header>
