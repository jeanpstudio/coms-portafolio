---
const currentYear = new Date().getFullYear();
---

<footer class="border-t py-6 md:px-8 md:py-0">
  <div class="container flex flex-col items-center justify-between gap-4 md:h-24 md:flex-row mx-auto px-4">
    <p class="text-balance text-center text-sm leading-loose text-muted-foreground md:text-left">
      Built with Astro, Tailwind, and React. &copy; {currentYear}.
    </p>
    <div class="flex items-center gap-4 text-sm font-medium text-muted-foreground">
      <a href="/privacy" class="underline underline-offset-4 hover:text-foreground">
        Privacy Policy
      </a>
      <a href="/terms" class="underline underline-offset-4 hover:text-foreground">
        Terms of Service
      </a>
    </div>
  </div>
</footer>
