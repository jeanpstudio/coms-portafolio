---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/portfolio/Navigation.astro";
import Hero from "../components/portfolio/Hero";
import CasesGrid from "../components/portfolio/CasesGrid";
import HybridSkills from "../components/portfolio/HybridSkills";
import FieldGallery from "../components/portfolio/FieldGallery";
import HybridProfile from "../components/portfolio/HybridProfile";
import ContactCTA from "../components/portfolio/ContactCTA";
---

<BaseLayout
  title="Jean Pierre Salguero | Communications Lead & Web Developer"
  description="Communications Lead & Web Developer | Multimedia Strategy for Global Conservation"
>
  <Navigation />
  <main class="w-full flex flex-col">
    <Hero client:load />
    <CasesGrid client:load />
    <HybridSkills client:load />
    <FieldGallery client:load />
    <HybridProfile client:load />
    <ContactCTA client:load />
  </main>
</BaseLayout>
