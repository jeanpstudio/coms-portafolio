---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout title="Inicio | AstroStarter Template">
  <Header />
  
  <main class="flex-1 flex flex-col items-center justify-center p-6 text-center">
    <div class="max-w-3xl space-y-6">
      <h1 class="text-4xl font-extrabold tracking-tight lg:text-5xl">
        Bienvenido a tu <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-blue-600">AstroStarter</span>
      </h1>
      <p class="text-xl text-muted-foreground">
        Una base profesional, escalable y optimizada diseñada por tu Senior Frontend Developer.
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-4 py-8">
        <a 
          href="/blog" 
          class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-8 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
        >
          Ver el Blog
        </a>
        <a 
          href="https://docs.astro.build" 
          target="_blank"
          class="inline-flex h-11 items-center justify-center rounded-md border border-input bg-background px-8 text-sm font-medium shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
        >
          Documentación de Astro
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-12">
        <div class="p-6 border rounded-xl bg-card text-card-foreground shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-bold mb-2">TypeScript</h3>
          <p class="text-sm text-muted-foreground">Seguridad de tipos en todo el proyecto para evitar errores en producción.</p>
        </div>
        <div class="p-6 border rounded-xl bg-card text-card-foreground shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-bold mb-2">Tailwind CSS</h3>
          <p class="text-sm text-muted-foreground">Estilizado rápido y responsivo con utilidad de clases modernas.</p>
        </div>
        <div class="p-6 border rounded-xl bg-card text-card-foreground shadow-sm hover:shadow-md transition-shadow">
          <h3 class="font-bold mb-2">MDX & Collections</h3>
          <p class="text-sm text-muted-foreground">Gestión de contenido potente y validada con esquemas de Zod.</p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
