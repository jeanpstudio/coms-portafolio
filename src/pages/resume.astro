---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Mail, MapPin, Globe, Printer, Download } from "lucide-react";

const resumeData = {
  name: "Jean Pierre Salguero",
  title: "Communications Lead | Multimedia Strategist | Web Developer",
  contact: {
    location: "Lima, Peru | Remote",
    email: "hola@tu-email.com",
    linkedin: "linkedin.com/in/tu-perfil",
    portfolio: "tu-portfolio.com",
  },
  summary:
    "Strategic Communications Leader with 10+ years of experience bridging the gap between high-altitude field storytelling and modern technical execution. Specialized in managing global narratives for multinational programs (UN Flagship, Earthshot Prize) while architecting high-performance digital ecosystems.",
  core_expertise: {
    strategy: [
      "Stakeholder Management",
      "Global PR & Crisis Comms",
      "Strategic Planning",
      "Budgeting ($15K+)",
    ],
    creative: [
      "Field Cinematography",
      "Scriptwriting",
      "Art Direction",
      "Adobe Creative Cloud",
      "DaVinci Resolve",
    ],
    tech: [
      "React / Astro",
      "Tailwind CSS",
      "Google Tag Manager",
      "GA4 Analytics",
      "WordPress Management",
    ],
  },
  experience: [
    {
      company: "Acción Andina / GFG / ECOAN",
      role: "Communications Lead & Coordinator",
      period: "2022 - Present",
      achievements: [
        "Architected the Annual Global Visibility Plan to elevate the program's international brand, leading to recognition from the UN and Earthshot Prize.",
        "Engineered a custom Operations Dashboard to centralize tracking for 11+ South American partners, ensuring 100% reporting compliance.",
        "Orchestrated cross-border communication strategies with GFG (USA) and local partners in Peru, Bolivia, Ecuador, and Argentina.",
        "Led field expeditions at 14,700 ft to verify narrative reports and produce high-end multimedia content for international fundraising.",
        "Designed and optimized the program’s web platform, implementing advanced SEO and interactive data visualization for donors.",
      ],
    },
    {
      company: "Grupo RRojas / Logica Consultoria",
      role: "Digital Analyst & Marketing Coordinator",
      period: "2020 - 2022",
      achievements: [
        "Directed the creative department in producing internal and external multimedia campaigns for 4 different business units.",
        "Managed multi-channel performance marketing (Facebook, Google, LinkedIn Ads) with a focus on conversion and brand positioning.",
        "Full-stack development of 3 corporate websites (almacenes-sos.com, solfipe.com, rci.pe) improving UX and lead generation.",
        "Oversaw content strategy and brand consistency across all social platforms for the holding's medical, financial, and industrial branches.",
      ],
    },
    {
      company: "IMX Interactive Brand Experience",
      role: "Audiovisual Editor & Motion Designer",
      period: "2020 - 2021",
      achievements: [
        "Developed high-impact audiovisual presentations for Fortune 500 clients like Kimberly Clark and Cencosud.",
        "Pioneered virtual environment setups for high-stakes B2B remote meetings, integrating real-time motion graphics.",
      ],
    },
    {
      company: "Foto A SRL",
      role: "Marketing Assistant & Lead Designer",
      period: "2012 - 2020",
      achievements: [
        "Managed B2B client portfolios and implemented seasonal growth strategies for major retail branches.",
        "Trained and led design teams in workflow optimization and efficient use of creative software.",
      ],
    },
  ],
  education: [
    {
      degree: "Bachelor’s Degree in Marketing & Commercial Management",
      institution: "Universidad San Ignacio de Loyola",
      details:
        "Focus on Strategic Planning, Consumer Behavior, and Market Analytics.",
    },
    {
      degree: "Professional Certifications in Digital Tech",
      institution: "Google / EOI Spain / IAB Spain",
      details:
        "Cloud Computing, Mobile App Dev, Digital Transformation, Web Development (HTML/CSS), and Digital Marketing.",
    },
  ],
};
---

<BaseLayout
  title={`${resumeData.name} | Resume`}
  description={`Resume of ${resumeData.name} - ${resumeData.title}`}
>
  <!-- Botón de Acción (Oculto en impresión) -->
  <div class="fixed bottom-8 right-8 flex gap-4 print:hidden z-50">
    <button
      onclick="window.print()"
      class="flex items-center gap-2 px-6 py-3 bg-foreground text-background rounded-full font-bold shadow-2xl hover:scale-105 transition-transform"
    >
      <Printer size={20} />
      <span>Print PDF</span>
    </button>
  </div>

  <main class="min-h-screen bg-zinc-100 py-12 px-4 print:p-0 print:bg-white">
    <div
      class="max-w-[850px] mx-auto bg-white shadow-2xl print:shadow-none min-h-[1100px] p-12 md:p-16 print:p-0 print:m-0"
    >
      {/* Header */}
      <header class="border-b-2 border-zinc-900 pb-8 mb-8">
        <h1
          class="text-4xl md:text-5xl font-black tracking-tighter uppercase mb-2"
        >
          {resumeData.name}
        </h1>
        <p
          class="text-primary font-bold uppercase tracking-widest text-sm mb-6"
        >
          {resumeData.title}
        </p>

        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-4 text-[11px] font-bold uppercase tracking-wider text-zinc-600"
        >
          <div class="flex items-center gap-2">
            <MapPin size={14} className="text-zinc-900" />
            <span>{resumeData.contact.location}</span>
          </div>
          <div class="flex items-center gap-2">
            <Mail size={14} className="text-zinc-900" />
            <span>{resumeData.contact.email}</span>
          </div>
          <div class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-3.5 h-3.5 text-zinc-900"
            >
              <path
                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
              ></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            <span>{resumeData.contact.linkedin}</span>
          </div>
          <div class="flex items-center gap-2">
            <Globe size={14} className="text-zinc-900" />
            <span>{resumeData.contact.portfolio}</span>
          </div>
        </div>
      </header>

      {/* Profile Summary */}
      <section class="mb-10">
        <h2
          class="text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-4 italic"
        >
          01. Profile Summary
        </h2>
        <p class="text-zinc-800 leading-relaxed font-medium">
          {resumeData.summary}
        </p>
      </section>

      {/* Core Expertise Grid */}
      <section class="mb-10">
        <h2
          class="text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-4 italic"
        >
          02. Core Expertise
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3
              class="text-xs font-black uppercase tracking-widest mb-3 border-b border-zinc-100 pb-2 text-zinc-900"
            >
              Strategy
            </h3>
            <ul class="space-y-1">
              {
                resumeData.core_expertise.strategy.map((item) => (
                  <li class="text-sm font-medium text-zinc-600">• {item}</li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3
              class="text-xs font-black uppercase tracking-widest mb-3 border-b border-zinc-100 pb-2 text-zinc-900"
            >
              Creative
            </h3>
            <ul class="space-y-1">
              {
                resumeData.core_expertise.creative.map((item) => (
                  <li class="text-sm font-medium text-zinc-600">• {item}</li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3
              class="text-xs font-black uppercase tracking-widest mb-3 border-b border-zinc-100 pb-2 text-zinc-900"
            >
              Technology
            </h3>
            <ul class="space-y-1">
              {
                resumeData.core_expertise.tech.map((item) => (
                  <li class="text-sm font-medium text-zinc-600">• {item}</li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      {/* Professional Experience */}
      <section class="mb-10">
        <h2
          class="text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-6 italic"
        >
          03. Professional Experience
        </h2>
        <div class="space-y-10">
          {
            resumeData.experience.map((exp) => (
              <div>
                <div class="flex justify-between items-baseline mb-3">
                  <h3 class="text-lg font-black tracking-tight">
                    {exp.company}
                  </h3>
                  <span class="text-xs font-bold text-zinc-400 font-mono tracking-widest">
                    {exp.period}
                  </span>
                </div>
                <p class="text-primary font-black uppercase tracking-[0.15em] text-[11px] mb-4">
                  {exp.role}
                </p>
                <ul class="space-y-2 list-none">
                  {exp.achievements.map((ach) => (
                    <li class="text-[13px] leading-relaxed text-zinc-700 font-medium pl-6 relative">
                      <span class="absolute left-0 top-2.5 w-1.5 h-[1px] bg-zinc-900" />
                      {ach}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      {/* Education & Certs */}
      <section>
        <h2
          class="text-[10px] font-black uppercase tracking-[0.3em] text-zinc-400 mb-6 italic"
        >
          04. Education & Certifications
        </h2>
        {
          resumeData.education.map((edu) => (
            <div class="border-l-2 border-zinc-900 pl-6 py-1">
              <h3 class="text-sm font-black uppercase tracking-widest mb-1">
                {edu.degree}
              </h3>
              <p class="text-[13px] font-bold text-primary italic mb-2">
                {edu.institution}
              </p>
              <p class="text-xs text-zinc-500 font-medium leading-relaxed">
                {edu.details}
              </p>
            </div>
          ))
        }
      </section>

      <footer
        class="mt-20 pt-8 border-t border-zinc-100 text-[10px] items-center justify-between flex text-zinc-300 font-mono uppercase tracking-widest"
      >
        <span>© 2024 {resumeData.name}</span>
        <span>Optimized for Digital & Print</span>
      </footer>
    </div>
  </main>
</BaseLayout>

<style is:global>
  @media print {
    body {
      background-color: white !important;
    }
    nav,
    footer:not(.print-footer) {
      display: none !important;
    }
    main {
      padding: 0 !important;
    }
    .print\:hidden {
      display: none !important;
    }
    @page {
      margin: 1cm;
      size: auto;
    }
  }
</style>
